# Base URL of the ResolveX API.
# Leave empty in development: vite.config.js proxies /api and /socket.io to
# localhost:4000, so the browser talks to a single origin.
# On Vercel set this to the API deployment's origin, e.g.
#   VITE_API_URL=https://resolvex-api.vercel.app
VITE_API_URL=

# Socket.IO origin. Empty means "same origin as the page".
VITE_SOCKET_URL=

# Real-time transport. Set to `off` on any serverless host (Vercel, Netlify,
# Cloudflare Workers): a request-scoped function cannot hold a websocket open,
# so the client skips the socket and refreshes on a timer instead.
#   on  (default) — live updates over Socket.IO
#   off           — no socket; poll every VITE_POLL_INTERVAL_MS
VITE_REALTIME=on

# How often the fallback refreshes when there is no live socket. Minimum 5000.
VITE_POLL_INTERVAL_MS=20000
