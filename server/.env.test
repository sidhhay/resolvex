# Test-only environment. No real credentials; the unit tests never open a socket
# or touch PostgreSQL — these values exist so config/env.js validation passes.
NODE_ENV=test
LOG_LEVEL=error
DATABASE_URL=postgres://resolvex:resolvex@127.0.0.1:5432/resolvex_test
JWT_SECRET=test-only-secret-value-of-sufficient-length-32
# Left ON so the Strategy-chain tests can inject stub providers. With no API
# keys configured the real LLM strategies report isAvailable() === false, so
# no test ever touches the network.
AI_ENABLED=true
MAIL_ENABLED=false
SLA_LEVEL1_DAYS=3
SLA_LEVEL2_DAYS=5
