# =============================================================================
# ResolveX API — environment
# Copy to .env and fill in.  `npm start` fails fast and lists every problem.
# =============================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated origins allowed by CORS and the Socket.IO handshake.
# localhost and 127.0.0.1 are *different* origins to a browser — list both
# in development or requests from one of them are rejected with a 403.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resolvex
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_SLOW_QUERY_MS=400

# ---- Authentication ---------------------------------------------------------
# REQUIRED, minimum 32 characters. Generate with: openssl rand -hex 32
# The server refuses to start in production while this is the placeholder below.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- SLA / escalation (Chain of Responsibility thresholds) ------------------
SLA_LEVEL1_DAYS=3            # idle days before escalating to the HOD
SLA_LEVEL2_DAYS=5            # idle days before escalating to the Dean/Director
SLA_RESOLUTION_TARGET_DAYS=7 # target used by the SLA-compliance metric
ESCALATION_CRON=0 * * * *    # hourly, standard 5-field cron
ESCALATION_CRON_TZ=UTC
ESCALATION_BATCH_SIZE=200
# Level-2 recipient. Falls back to the longest-serving active admin when unset.
ESCALATION_L2_EMAIL=dean@resolvex.edu
# true runs the sweep inside the API process (fine for one instance).
# Set false in production and run `npm run escalate:cron` as its own worker.
ESCALATION_IN_PROCESS=true

# ---- AI classification (Strategy pattern) -----------------------------------
# Leave both keys empty to run entirely on the rule-based keyword engine.
AI_ENABLED=true
AI_TIMEOUT_MS=8000
AI_MIN_CONFIDENCE=0.35       # below this the LLM verdict is discarded

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Second in the chain; also works against any OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- E-mail (Observer -> Nodemailer) ----------------------------------------
# With MAIL_ENABLED=false, messages are written to the log instead of sent.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ResolveX <no-reply@resolvex.edu>
APP_URL=http://localhost:5173

# ---- Attachments ------------------------------------------------------------
# With Cloudinary unset, files are written to UPLOAD_DIR and served from /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=resolvex/complaints
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif,application/pdf

# ---- Serverless deployment (Vercel) -----------------------------------------
# Shared secret for the scheduled escalation sweep. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`; the endpoint refuses to run without it.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# On a serverless host set these too:
#   ESCALATION_IN_PROCESS=false   the Vercel Cron Job runs the sweep instead
#   DATABASE_POOL_MAX=1           each warm instance keeps its own pool
#   CLOUDINARY_*                  required — the filesystem does not persist
# See DEPLOYMENT.md.

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_MAX=60
