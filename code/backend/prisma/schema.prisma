generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id       Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("COMPLAINANT")
  department_id Int?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}
